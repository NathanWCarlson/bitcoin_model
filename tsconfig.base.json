{
  "compilerOptions": {
    "target": "ES2021",
    "lib": ["DOM", "DOM.Iterable", "ES2021"],
    "module": "ESNext",
    "moduleResolution": "Node",
    "esModuleInterop": true,
    "allowJs": false,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@bitcoin24/ui": ["packages/ui/src"],
      "@bitcoin24/ui/*": ["packages/ui/src/*"],
      "@bitcoin24/config": ["packages/config/src"],
      "@bitcoin24/config/*": ["packages/config/src/*"]
    }
  }
}
