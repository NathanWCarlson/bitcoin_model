{
  "name": "bitcoin-model",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "eslint \"src/**/*.{ts,tsx}\" --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:playwright": "playwright test",
    "preview:static": "http-server public -p 4173 -s",
    "audit:lighthouse": "lhci autorun --config=lighthouserc.json",
    "audit:axe": "axe --exit 1 --tags wcag2a,wcag2aa public/index.html",
    "metrics:check": "tsx scripts/check-metrics.ts"
  },
  "devDependencies": {
    "@axe-core/cli": "4.8.2",
    "@lhci/cli": "0.12.2",
    "@playwright/test": "1.44.1",
    "@typescript-eslint/eslint-plugin": "7.13.1",
    "@typescript-eslint/parser": "7.13.1",
    "eslint": "8.57.0",
    "eslint-config-prettier": "9.1.0",
    "eslint-plugin-import": "2.29.1",
    "eslint-plugin-jsx-a11y": "6.8.0",
    "eslint-plugin-react": "7.34.3",
    "eslint-plugin-react-hooks": "4.6.0",
    "eslint-plugin-react-perf": "4.3.1",
    "http-server": "14.1.1",
    "typescript": "5.4.5",
    "vitest": "1.6.0",
    "tsx": "4.7.1"
  }
  "name": "bitcoin-model-app",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.3.4",
    "@tanstack/react-query": "^5.29.2",
    "@tanstack/react-query-devtools": "^5.29.2",
    "clsx": "^2.1.0",
    "date-fns": "^3.6.0",
    "framer-motion": "^11.0.12",
    "immer": "^10.0.0",
    "lucide-react": "^0.368.0",
    "nanoid": "^5.0.7",
    "next": "^14.1.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hot-toast": "^2.4.1",
    "react-hook-form": "^7.51.5",
    "zustand": "^4.4.7",
    "zustand-middleware": "^1.0.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.4.2",
    "@testing-library/react": "^14.2.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^20.12.7",
    "@types/react": "^18.2.39",
    "@types/react-dom": "^18.2.17",
    "autoprefixer": "^10.4.16",
    "eslint": "^8.56.0",
    "eslint-config-next": "^14.1.0",
    "msw": "^2.2.3",
    "postcss": "^8.4.33",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.3",
    "vitest": "^1.3.1"
  }
  "name": "bitcoin24-monorepo",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@8.15.4",
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm --filter web build",
    "lint": "pnpm --filter web lint",
    "storybook": "pnpm --filter @bitcoin24/ui storybook",
    "storybook:build": "pnpm --filter @bitcoin24/ui build-storybook"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
