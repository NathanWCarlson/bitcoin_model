    "prisma:generate": "prisma generate",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "dependencies": {
    "@fastify/cookie": "^9.1.0",
    "@nestjs/apollo": "^12.0.0",
    "@nestjs/common": "^10.0.0",
